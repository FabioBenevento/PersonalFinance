rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function autorizzato(uid) {
      return request.auth != null && request.auth.uid == uid
        && exists(/databases/$(database)/documents/allowlist/$(uid));
    }

    function idVoce(v) {
      return v is string && v.size() >= 1 && v.size() <= 128 && v.matches('[A-Za-z0-9_-]+');
    }

    match /allowlist/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /users/{uid} {
      allow read, write: if autorizzato(uid);

      // Le collezioni broker sono escluse dal match generico: un allow sovrapposto le renderebbe scrivibili.
      match /{coll}/{document=**} {
        allow read, write: if autorizzato(uid)
          && !(coll in ['brokerStato', 'brokerRilevazioni', 'brokerAssociazioni', 'brokerApplicazioni']);
      }

      match /brokerStato/{document=**} {
        allow read: if autorizzato(uid);
        allow write: if false;
      }

      match /brokerRilevazioni/{document=**} {
        allow read: if autorizzato(uid);
        allow write: if false;
      }

      match /brokerAssociazioni/{idConto} {
        allow read: if autorizzato(uid);
        allow create, update: if autorizzato(uid)
          && request.resource.data.keys().hasOnly(['revisione', 'liquidita', 'investimenti'])
          && request.resource.data.keys().hasAll(['revisione'])
          && request.resource.data.revisione is int
          && request.resource.data.revisione == (resource == null ? 1 : resource.data.revisione + 1)
          && (!('liquidita' in request.resource.data) || idVoce(request.resource.data.liquidita))
          && (!('investimenti' in request.resource.data) || idVoce(request.resource.data.investimenti));
        allow delete: if autorizzato(uid);
      }

      match /brokerApplicazioni/{idOperazione} {
        allow read: if autorizzato(uid);
        allow create: if autorizzato(uid)
          && request.resource.data.keys().hasOnly(['rilevazione', 'applicataAt', 'conti'])
          && request.resource.data.keys().hasAll(['rilevazione', 'applicataAt', 'conti'])
          && request.resource.data.rilevazione is string
          && request.resource.data.applicataAt is timestamp
          && request.resource.data.conti is map;
        allow update, delete: if false;
      }
    }
  }
}
